# ==============================================================================
# BHARAT UTKARSH MAHAYAGYA 2026 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Indian UPI Payment Gateway (Razorpay Standard)
# Obtain these credentials from your Razorpay Dashboard (https://dashboard.razorpay.com/app/keys)
PAYMENT_KEY_ID=rzp_live_your_key_id_here
PAYMENT_KEY_SECRET=your_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# 2. Application Host & Server Port
APP_URL=http://localhost:3000
PORT=3000

# 3. Database URL (Optional - defaults to SQLite WASM persistence under ./data/yagya.sqlite)
DATABASE_URL=sqlite://data/yagya.sqlite

# 4. Supabase Database & Realtime Sync (Optional remote mirror)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 5. Internal Security & Signature Keys
PAYMENT_SECRET_KEY=MAHARISHI_YAGYA_SECURE_KEY_2026_V1
